# Application
APP_ENV=development
STRICT_READINESS_CHECKS=false
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://lentic:lentic@localhost:5432/lentic_db

# Redis
REDIS_URL=redis://localhost:6379

# First admin user (created on startup if no users exist)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=changeme
