{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lentic-pipe.local/schemas/closure_v1/phase4_synthesis.schema.json",
  "title": "Closure V1 Phase 4 synthesis freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "closure_source_commit",
    "topology",
    "input_policy",
    "allowed_inputs",
    "matrices",
    "outputs",
    "invariants",
    "rounding",
    "captions",
    "adjudication"
  ],
  "properties": {
    "contract_version": {
      "const": "closure_v1_phase4_synthesis_v1"
    },
    "closure_source_commit": {
      "const": "ea8ddce7f8edb9a61db97e29178e52603fa371b1"
    },
    "topology": {
      "type": "object",
      "required": [
        "ordered_stages",
        "H-SYN",
        "P-SYN",
        "R-SYN",
        "closure_source_commit_must_remain_ancestor",
        "direct_parent_publication_required",
        "clean_worktree_and_index_required_at_each_gate",
        "aligned_refs_and_live_remote_required"
      ],
      "properties": {
        "ordered_stages": {"const": ["H-SYN", "P-SYN", "R-SYN"]},
        "H-SYN": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "synthesis_outputs_authorized", "outcome_access_authorized"],
          "properties": {
            "role": {"const": "implementation_schema_tests_and_freeze"},
            "synthesis_outputs_authorized": {"const": false},
            "outcome_access_authorized": {"const": false}
          }
        },
        "P-SYN": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "requires_published_H_SYN", "outcome_access_authorized", "ordered_outputs", "manifest_written_last"],
          "properties": {
            "role": {"const": "data_only_synthesis_authority"},
            "requires_published_H_SYN": {"const": true},
            "outcome_access_authorized": {"const": false},
            "ordered_outputs": {
              "const": [
                "configs/closure_v1/phase4_synthesis_authority.json",
                "configs/closure_v1/phase4_synthesis_authority_manifest.json"
              ]
            },
            "manifest_written_last": {"const": true}
          }
        },
        "R-SYN": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "requires_published_P_SYN", "outcome_access_authorized", "output_count", "manifest_written_last"],
          "properties": {
            "role": {"const": "deterministic_synthesis_render"},
            "requires_published_P_SYN": {"const": true},
            "outcome_access_authorized": {"const": false},
            "output_count": {"const": 24},
            "manifest_written_last": {"const": true}
          }
        },
        "closure_source_commit_must_remain_ancestor": {"const": true},
        "direct_parent_publication_required": {"const": true},
        "clean_worktree_and_index_required_at_each_gate": {"const": true},
        "aligned_refs_and_live_remote_required": {"const": true}
      },
      "additionalProperties": false
    },
    "input_policy": {
      "type": "object",
      "required": [
        "closed_allowlist",
        "discovery_forbidden",
        "follow_manifest_paths",
        "follow_symlinks",
        "recursive_walk_forbidden",
        "resolve_dvc_pointers",
        "read_dvc_payloads",
        "inputs_are_read_only",
        "forbidden_prefixes",
        "forbidden_suffixes",
        "markdown_and_xml_as_numerical_sources",
        "dvc_pointers_are_identity_evidence_only",
        "embedded_path_strings_are_not_inputs"
      ],
      "properties": {
        "closed_allowlist": {"const": true},
        "discovery_forbidden": {"const": true},
        "follow_manifest_paths": {"const": false},
        "follow_symlinks": {"const": false},
        "recursive_walk_forbidden": {"const": true},
        "resolve_dvc_pointers": {"const": false},
        "read_dvc_payloads": {"const": false},
        "inputs_are_read_only": {"const": true},
        "forbidden_prefixes": {"const": ["private/", "data/targets/"]},
        "forbidden_suffixes": {"const": [".parquet", ".jsonl", ".md", ".xml"]},
        "markdown_and_xml_as_numerical_sources": {"const": "forbidden"},
        "dvc_pointers_are_identity_evidence_only": {"const": true},
        "embedded_path_strings_are_not_inputs": {"const": true}
      },
      "additionalProperties": false
    },
    "allowed_inputs": {
      "type": "array",
      "minItems": 83,
      "maxItems": 83,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "format"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!private/)(?!data/targets/)(?!.*[?*\\[\\]{}]).+$",
            "not": {"pattern": "(?:\\.parquet|\\.jsonl|\\.md|\\.xml)$"}
          },
          "role": {"type": "string", "minLength": 1},
          "format": {"enum": ["csv", "json", "yaml", "dvc"]},
          "allow_empty": {"type": "boolean", "default": false}
        }
      }
    },
    "matrices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_closure_matrix", "thesis_claim_evidence_matrix"],
      "properties": {
        "final_closure_matrix": {
          "type": "object",
          "required": ["path", "columns", "sort_key"],
          "properties": {
            "path": {"const": "reports/closure_v1/11_synthesis/FINAL_CLOSURE_MATRIX.csv"},
            "columns": {
              "const": [
