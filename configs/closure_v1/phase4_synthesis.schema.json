                "decisive_experiments",
                "estimand",
                "population",
                "model_or_pair",
                "availability_state",
                "attempted_denominator",
                "successful_denominator",
                "metric",
                "estimate",
                "uncertainty",
                "multiplicity_family",
                "verdict",
                "limitation_code",
                "evidence_paths",
                "authority_commit"
              ]
            },
            "sort_key": {"const": ["hypothesis_id", "metric", "estimand", "model_or_pair"]}
          },
          "additionalProperties": false
        },
        "thesis_claim_evidence_matrix": {
          "type": "object",
          "required": ["path", "columns", "sort_key"],
          "properties": {
            "path": {"const": "reports/closure_v1/11_synthesis/THESIS_CLAIM_EVIDENCE_MATRIX.csv"},
            "columns": {
              "const": [
                "claim_id",
                "chapter",
                "section",
                "claim_text",
                "claim_status",
                "artifact_path",
                "row_filter_or_record",
                "metric",
                "value_or_state",
                "denominator",
                "authority_commit",
                "limitation",
                "allowed_wording",
                "forbidden_wording"
              ]
            },
            "sort_key": {"const": ["claim_id", "chapter", "section", "artifact_path", "row_filter_or_record"]}
          },
          "additionalProperties": false
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "atomic_bundle", "no_clobber", "manifest_written_last", "ordered_paths"],
      "properties": {
        "root": {"const": "reports/closure_v1/11_synthesis"},
        "atomic_bundle": {"const": true},
        "no_clobber": {"const": true},
        "manifest_written_last": {"const": true},
        "ordered_paths": {
          "const": [
            "reports/closure_v1/11_synthesis/FINAL_CLOSURE_MATRIX.csv",
            "reports/closure_v1/11_synthesis/THESIS_CLAIM_EVIDENCE_MATRIX.csv",
            "reports/closure_v1/11_synthesis/FINAL_CLOSURE_REPORT.md",
