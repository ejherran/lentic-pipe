      "properties": {
        "attempted_gate": {"const": "E0-MCAL"},
        "status": {"const": "interrupted_no_authority"},
        "phase": {"const": "indeterminate"},
        "authority_created": {"const": false},
        "final_output_count": {"const": 0},
        "temporary_output_count": {"const": 0},
        "active_guard_count": {"const": 0},
        "scientific_execution_run": {"const": false},
        "dvc_commands_run": {"const": false},
        "side_effect_count": {"const": 0}
