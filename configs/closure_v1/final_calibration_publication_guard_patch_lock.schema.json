  "$defs": {
    "gitArtifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256", "git_oid", "git_mode"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_mode": {"const": "100644"}
      }
    },
    "historicalArtifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256", "git_oid", "git_mode", "commit"],
      "properties": {
        "role": {"const": "superseded_h_mcal_component"},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_mode": {"const": "100644"},
        "commit": {"const": "5d096e8ca560a592a65ab231ae173c4d3b5a4ff6"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "modified", "deleted", "path_count", "paths"],
      "properties": {
        "added": {"const": 5},
        "modified": {"const": 4},
        "deleted": {"const": 0},
        "path_count": {"const": 9},
        "paths": {
          "const": [
            "configs/closure_v1/final_calibration_publication_guard_patch_lock.schema.json",
            "docs/closure_v1/E0_M_FINAL_CALIBRATION_PUBLICATION_GUARD_PATCH_1.md",
            "src/experiments/calibrate_closure_final_models.py",
            "src/experiments/closure_final_calibration_publication_guard_patch.py",
            "src/experiments/lock_closure_final_calibration_publication_guard_patch.py",
            "src/experiments/run_closure_anfis_learning_curve.py",
            "tests/test_calibrate_closure_final_models.py",
            "tests/test_closure_anfis_learning_curve.py",
            "tests/test_closure_final_calibration_publication_guard_patch.py"
          ]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_h_mcal_commit", "h_patch_head", "branch", "remote_head", "scope"],
      "properties": {
        "base_h_mcal_commit": {"const": "5d096e8ca560a592a65ab231ae173c4d3b5a4ff6"},
        "h_patch_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"const": "main"},
        "remote_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "interruptedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted_gate",
        "status",
        "phase",
        "authority_created",
        "final_output_count",
        "temporary_output_count",
        "active_guard_count",
        "scientific_execution_run",
        "dvc_commands_run",
        "side_effect_count"
