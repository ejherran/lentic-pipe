{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lentic-pipe.local/schemas/closure_v1/final_calibration_publication_guard_patch_lock.schema.json",
  "title": "Closure V1 E0-MCALP final-calibration publication-guard patch lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "gate",
    "status",
    "generated_at_utc",
    "repository",
    "interrupted_attempt",
    "h_mcal_authority",
    "h_patch",
    "runtime",
    "scientific_input_inventory",
    "scientific_boundary",
    "model_matrix",
    "calibration_group_matrix",
    "e7_terminal_record",
    "output_contract",
    "prelock",
    "verification",
    "authorizations"
