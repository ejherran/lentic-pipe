    "hMcalAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "commit",
        "parent",
        "component_count",
        "preserved_count",
        "superseded_count",
        "components",
        "components_sha256",
        "preserved_components",
        "preserved_components_sha256",
        "historical_inputs",
        "historical_inputs_sha256"
      ],
      "properties": {
        "gate": {"const": "H-E0-MCAL"},
        "commit": {"const": "5d096e8ca560a592a65ab231ae173c4d3b5a4ff6"},
        "parent": {"const": "2f46d3e258195315e2473be6cf7d62db22c55bcf"},
        "component_count": {"const": 12},
        "preserved_count": {"const": 8},
        "superseded_count": {"const": 4},
        "components": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/gitArtifactRecord"}},
        "components_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preserved_components": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/gitArtifactRecord"}},
        "preserved_components_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "historical_inputs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/historicalArtifactRecord"}},
        "historical_inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "hPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "component_count", "added_count", "modified_count", "components", "components_sha256"],
      "properties": {
        "gate": {"const": "H-E0-MCALP"},
        "component_count": {"const": 9},
        "added_count": {"const": 5},
        "modified_count": {"const": 4},
        "components": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/gitArtifactRecord"}},
        "components_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "prelock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_status_clean",
        "legacy_p_output_present_count",
        "p_output_present_count",
        "r_output_present_count",
        "temporary_present_count",
        "coordination_present_count",
        "outcome_access_log_absent",
        "holdout_rows_opened",
        "post_2021_rows_opened",
        "dvc_commands_run",
        "scientific_writes_performed",
        "companion_contract"
      ],
      "properties": {
        "git_status_clean": {"const": true},
        "legacy_p_output_present_count": {"const": 0},
        "p_output_present_count": {"const": 0},
        "r_output_present_count": {"const": 0},
        "temporary_present_count": {"const": 0},
        "coordination_present_count": {"const": 0},
        "outcome_access_log_absent": {"const": true},
        "holdout_rows_opened": {"const": false},
        "post_2021_rows_opened": {"const": false},
        "dvc_commands_run": {"const": false},
        "scientific_writes_performed": {"const": false},
        "companion_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["physical_input_count", "historical_input_count", "output_count", "script_path", "manifest_written_last"],
