      "properties": {
        "gate": {"const": "P-E0-MCALG"},
        "commit": {"const": "34a4578efa37d0ccf09e7fc45adf655d3b5a21c1"},
        "parent_h_mcalg": {"const": "ba15b7647811bbef2b63b3eb904ba427788da048"},
