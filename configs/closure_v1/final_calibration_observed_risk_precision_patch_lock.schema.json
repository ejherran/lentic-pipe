        "modified_count": {"const": 4},
        "components": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/gitArtifactRecord"}},
        "components_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
