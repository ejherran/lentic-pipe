        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_mode": {"const": "100644"}
      }
    },
    "historicalArtifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256", "git_oid", "git_mode", "commit"],
      "properties": {
        "role": {"const": "superseded_h_mcalg_component"},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
