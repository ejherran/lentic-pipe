{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lentic-pipe.local/schemas/closure_v1/development_runtime_sequence_patch_lock.schema.json",
  "title": "Closure V1 development runtime sequence serialization patch lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "status",
    "experiment_id",
    "gate",
    "patch_id",
    "created_at_utc",
    "base_authority",
    "patch_repository",
    "patch_components",
    "git_diff",
    "compatibility_correction",
    "p0_outputs",
    "verification",
    "authorizations",
    "seals",
    "lock_artifact"
  ],
  "properties": {
    "lock_version": {
      "const": "closure_development_runtime_sequence_patch_lock_v1"
    },
    "status": {"const": "locked"},
    "experiment_id": {"const": "closure_v1"},
    "gate": {"const": "E0-DLS"},
    "patch_id": {
      "const": "development_runtime_sequence_serialization_patch_1"
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "base_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_repository_head",
        "e0_dlp_patch_head",
        "e0_dlp_lock_commit",
        "records",
        "records_sha256",
        "preserved_components",
        "base_e0_dl_unchanged",
        "base_e0_dlp_unchanged",
        "historical_schema_and_payload_validated",
        "physical_development_authority_verified",
        "e0_dlp_adopted_seed_physical_artifacts_verified"
      ],
      "properties": {
        "base_repository_head": {"$ref": "#/$defs/commit"},
        "e0_dlp_patch_head": {"$ref": "#/$defs/commit"},
        "e0_dlp_lock_commit": {"$ref": "#/$defs/commit"},
        "records": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/fileRecord"}
        },
        "records_sha256": {"$ref": "#/$defs/sha256"},
        "preserved_components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "paths",
            "paths_sha256",
            "records",
            "records_sha256"
          ],
          "properties": {
            "count": {"type": "integer"},
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "paths_sha256": {"$ref": "#/$defs/sha256"},
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/fileRecord"}
            },
            "records_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "base_e0_dl_unchanged": {"const": true},
        "base_e0_dlp_unchanged": {"const": true},
        "historical_schema_and_payload_validated": {"const": true},
        "physical_development_authority_verified": {"const": true},
        "e0_dlp_adopted_seed_physical_artifacts_verified": {"const": true}
      }
    },
    "patch_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "parent",
        "branch",
        "published_ref",
        "published_head",
        "remote_main_oid",
        "worktree_status",
        "exact_diff_verified"
      ],
      "properties": {
        "head": {"$ref": "#/$defs/commit"},
        "parent": {"$ref": "#/$defs/commit"},
        "branch": {"const": "main"},
        "published_ref": {"const": "origin/main"},
        "published_head": {"$ref": "#/$defs/commit"},
        "remote_main_oid": {"$ref": "#/$defs/commit"},
        "worktree_status": {"const": "clean"},
        "exact_diff_verified": {"const": true}
      }
    },
    "patch_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "paths",
        "paths_sha256",
        "records",
        "records_sha256"
      ],
      "properties": {
        "count": {"const": 11},
        "paths": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "paths_sha256": {"$ref": "#/$defs/sha256"},
        "records": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"$ref": "#/$defs/fileRecord"}
        },
        "records_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "git_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "patch_head",
        "entries",
        "paths",
        "paths_sha256",
        "only_allowed_additions_and_modifications"
      ],
      "properties": {
        "base_commit": {"$ref": "#/$defs/commit"},
        "patch_head": {"$ref": "#/$defs/commit"},
        "entries": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"$ref": "#/$defs/diffEntry"}
        },
        "paths": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "paths_sha256": {"$ref": "#/$defs/sha256"},
        "only_allowed_additions_and_modifications": {"const": true}
      }
    },
    "compatibility_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_exception",
        "upstream_reference",
        "affected_storage",
        "sequence_physical_type",
        "sequence_failure_encoding",
        "sequence_logical_null_policy",
        "rollout_state_physical_type",
        "rollout_irc_physical_type",
        "rollout_failure_encoding",
        "success_payload_changed",
        "scalar_target_null_encoding_changed",
        "failure_status_is_authoritative",
        "partially_null_tensor_accepted",
        "finite_failure_placeholder_accepted",
        "sequence_bundle_guard",
        "sequence_output_publication"
      ],
      "properties": {
        "trigger_exception": {
          "const": "pyarrow.lib.ArrowNotImplementedError: Lists with non-zero length null components are not supported"
        },
        "upstream_reference": {"const": "apache/arrow#24425"},
        "affected_storage": {"const": "Parquet"},
        "sequence_physical_type": {"const": "fixed_size_list<float32>[12]"},
        "sequence_failure_encoding": {
          "const": "outer_valid_with_12_null_float32_children"
        },
        "sequence_logical_null_policy": {
          "const": "none_or_exact_shape_12_all_missing"
        },
        "rollout_state_physical_type": {
          "const": "fixed_size_list<float32>[128]"
        },
        "rollout_irc_physical_type": {
          "const": "fixed_size_list<float64>[128]"
        },
        "rollout_failure_encoding": {
          "const": "outer_valid_with_128_null_children"
        },
        "success_payload_changed": {"const": false},
        "scalar_target_null_encoding_changed": {"const": false},
        "failure_status_is_authoritative": {"const": true},
        "partially_null_tensor_accepted": {"const": false},
        "finite_failure_placeholder_accepted": {"const": false},
        "sequence_bundle_guard": {
          "const": "exclusive_ignored_guard_held_through_publication"
        },
        "sequence_output_publication": {
          "const": "exclusive_temp_inode_hardlink_no_clobber"
        }
      }
    },
    "p0_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "paths", "paths_sha256", "all_absent_at_lock"],
      "properties": {
        "count": {"const": 8},
        "paths": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "paths_sha256": {"$ref": "#/$defs/sha256"},
        "all_absent_at_lock": {"const": true}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_type_check",
        "focused_tests",
        "poetry_check",
        "publication_guard",
        "git_diff_check"
      ],
      "properties": {
        "full_type_check": {"$ref": "#/$defs/commandEvidence"},
        "focused_tests": {"$ref": "#/$defs/focusedCommandEvidence"},
        "poetry_check": {"$ref": "#/$defs/commandEvidence"},
        "publication_guard": {"$ref": "#/$defs/commandEvidence"},
        "git_diff_check": {"$ref": "#/$defs/commandEvidence"}
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_fit_authorized",
        "evaluation_authorized",
        "e0_u_authorized",
        "future_outcomes_accessed"
      ],
      "properties": {
        "development_fit_authorized": {"const": true},
        "evaluation_authorized": {"const": false},
        "e0_u_authorized": {"const": false},
        "future_outcomes_accessed": {"const": false}
      }
    },
    "seals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_decisions_changed",
        "common_origin_denominator_changed",
        "role_denominators_changed",
        "state_or_target_values_imputed",
        "runtime_config_changed",
        "base_e0_dl_replaced",
        "base_e0_dlp_replaced",
        "p0_materialized_at_lock",
        "evaluation_opened",
        "e0_u_opened",
        "future_outcomes_accessed",
        "dvc_operation_executed"
      ],
      "properties": {
        "scientific_decisions_changed": {"const": false},
        "common_origin_denominator_changed": {"const": false},
        "role_denominators_changed": {"const": false},
        "state_or_target_values_imputed": {"const": false},
        "runtime_config_changed": {"const": false},
        "base_e0_dl_replaced": {"const": false},
        "base_e0_dlp_replaced": {"const": false},
        "p0_materialized_at_lock": {"const": false},
        "evaluation_opened": {"const": false},
        "e0_u_opened": {"const": false},
        "future_outcomes_accessed": {"const": false},
        "dvc_operation_executed": {"const": false}
      }
    },
    "lock_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "self_hash_policy"],
      "properties": {
        "path": {
          "const": "reports/closure_v1/00_protocol/development_runtime_sequence_patch_lock.json"
        },
        "role": {
          "const": "external_development_runtime_sequence_patch_lock"
        },
        "self_hash_policy": {
          "const": "verified_from_committed_and_published_bytes"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "diffEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path"],
      "properties": {
        "status": {"enum": ["A", "M"]},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_line_count",
        "stderr_line_count",
        "success_marker_verified"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "exit_code": {"const": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "stdout_line_count": {"type": "integer"},
        "stderr_line_count": {"type": "integer"},
        "success_marker_verified": {"const": true}
      }
    },
    "focusedCommandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_line_count",
        "stderr_line_count",
        "success_marker_verified",
        "test_count",
        "skipped_count",
        "deselected_count"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "exit_code": {"const": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "stdout_line_count": {"type": "integer"},
        "stderr_line_count": {"type": "integer"},
        "success_marker_verified": {"const": true},
        "test_count": {"type": "integer"},
        "skipped_count": {"const": 0},
        "deselected_count": {"const": 0}
      }
    }
  }
}
