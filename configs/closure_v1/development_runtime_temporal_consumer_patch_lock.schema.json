        "remote_main_oid": {"$ref": "#/$defs/commit"},
        "worktree_status": {"const": "clean"},
        "exact_diff_verified": {"const": true}
      }
    },
    "patch_components": {
      "allOf": [
        {"$ref": "#/$defs/fileBundle"},
        {
          "type": "object",
          "properties": {
            "count": {"const": 11},
            "paths": {"minItems": 11, "maxItems": 11},
            "records": {"minItems": 11, "maxItems": 11}
          }
