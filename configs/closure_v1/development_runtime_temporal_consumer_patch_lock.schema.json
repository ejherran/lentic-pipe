      ],
      "properties": {
        "classification": {"const": "implementation_hardening_only"},
        "scientific_runtime_contract_changed": {"const": false},
        "seed_set_changed": {"const": false},
        "denominator_changed": {"const": false},
        "state_mapping_changed": {"const": false},
        "model_unavailable_semantics_changed": {"const": false},
        "consumer_publication": {
          "const": "exclusive_slot_guard_atomic_no_clobber_manifest_last"
        },
        "consumer_failure_rollback": {"const": "owned_inode_only"},
