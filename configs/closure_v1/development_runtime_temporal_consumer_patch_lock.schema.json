          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {"$ref": "#/$defs/diffEntry"}
        },
        "paths": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "paths_sha256": {"$ref": "#/$defs/sha256"},
        "only_allowed_additions_and_modifications": {"const": true}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "scientific_runtime_contract_changed",
        "seed_set_changed",
        "denominator_changed",
        "state_mapping_changed",
        "model_unavailable_semantics_changed",
        "consumer_publication",
        "consumer_failure_rollback",
        "expected_p0_slot_status",
        "expected_p0_fit_status",
        "expected_p0_failure_reason",
