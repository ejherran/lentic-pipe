              "type": "object",
              "properties": {
                "count": {"const": 5},
                "paths": {"minItems": 5, "maxItems": 5},
                "records": {"minItems": 5, "maxItems": 5}
              }
            }
          ]
        },
        "superseded_components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "paths",
            "paths_sha256",
