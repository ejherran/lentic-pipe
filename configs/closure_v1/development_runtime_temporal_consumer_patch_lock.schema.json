    "seals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_e0_dl_preserved",
        "base_e0_dlp_preserved",
        "base_e0_dls_preserved_as_historical_authority",
        "p0_sequence_bundle_preserved",
        "holdout_accessed",
        "post_2021_outcomes_accessed",
        "does_not_replace_e0_m"
