      "additionalProperties": false,
      "required": ["path", "role", "self_hash_policy"],
      "properties": {
        "path": {
          "const": "reports/closure_v1/00_protocol/development_runtime_temporal_consumer_patch_lock.json"
        },
        "role": {
          "const": "external_development_runtime_temporal_consumer_patch_lock"
        },
        "self_hash_policy": {
          "const": "verified_from_committed_and_published_bytes"
        }
      }
