        "count": {"const": 95},
        "paths": {
          "type": "array",
          "minItems": 95,
          "maxItems": 95,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "paths_sha256": {"$ref": "#/$defs/sha256"},
        "all_absent_at_lock": {"const": true}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_type_check",
        "focused_tests",
        "poetry_check",
        "publication_guard",
        "git_diff_check",
        "dvc_push_first",
        "dvc_push_second"
      ],
      "properties": {
        "full_type_check": {"$ref": "#/$defs/commandEvidence"},
        "focused_tests": {"$ref": "#/$defs/focusedEvidence"},
        "poetry_check": {"$ref": "#/$defs/commandEvidence"},
        "publication_guard": {"$ref": "#/$defs/commandEvidence"},
        "git_diff_check": {"$ref": "#/$defs/commandEvidence"},
