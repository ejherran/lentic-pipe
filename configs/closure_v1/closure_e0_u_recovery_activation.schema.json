          "type": "array",
          "minItems": 48,
          "maxItems": 48,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/closurePath"}
        },
        "dvc_pointer_paths": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^.+\\.parquet\\.dvc$"}
        },
        "heavy_artifact_paths": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^.+\\.parquet$"}
        },
        "dvc_add_after_success_only": {"const": true},
        "dvc_push_after_audit_only": {"const": true},
        "implicit_dvc_forbidden": {"const": true}
      }
