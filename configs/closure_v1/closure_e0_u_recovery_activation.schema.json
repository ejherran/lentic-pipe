  "properties": {
    "schema_version": {"const": "closure_e0_u_recovery_activation_v1"},
    "experiment_id": {"const": "closure_v1"},
    "gate": {"const": "E0-U"},
    "attempt_ordinal": {"const": 2},
    "first_attempt": {"const": false},
    "execution_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "const": "closure-v1-e0-u-caaf2d6d0a00a31f-735c2cf8ab3715aa"
      }
    },
    "git_remote_url": {
      "const": "https://github.com/ejherran/lentic-pipe.git"
    },
    "sealed_recovery_batch_command": {
      "const": "/usr/bin/env -i LANG=C LC_ALL=C .venv/bin/python -I -S -B src/experiments/run_closure_benchmark.py --execute-sealed-recovery-batch\n"
    },
    "recovery_guard_path": {
      "const": "tmp/closure_v1_e0_u_recovery_1/sealed_batch.guard"
    },
    "historical_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_r_commit",
        "h1_commit",
        "p1_commit",
        "u1_activation",
        "u1_commit"
      ],
      "properties": {
        "base_r_commit": {
          "const": "4c92ed7249a91b7dd541fd22dde68b61574556b2"
        },
        "h1_commit": {
          "const": "9e66478d7c071067a750e7dd9a6a318fa93a2c88"
        },
        "p1_commit": {
          "const": "caaf2d6d0a00a31febeed89b54ea078b60d7f92a"
        },
        "u1_commit": {
          "const": "4aecf19cd913b82a6a3d26669f09684e67efda8a"
        },
        "u1_activation": {"$ref": "#/$defs/u1Activation"}
      }
    },
    "recovery_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h2_commit", "h2_scope", "p2_commit", "p2_scope"],
      "properties": {
        "h2_commit": {"$ref": "#/$defs/gitCommit"},
        "p2_commit": {"$ref": "#/$defs/gitCommit"},
        "h2_scope": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "prefixItems": [
            {"$ref": "#/$defs/h2SchemaRecord"},
            {"$ref": "#/$defs/h2DocumentRecord"},
            {"$ref": "#/$defs/h2ReceiptRecord"},
            {"$ref": "#/$defs/h2CommandRecord"},
            {"$ref": "#/$defs/h2AccessLogRecord"},
            {"$ref": "#/$defs/h2PrecommitRecord"},
            {"$ref": "#/$defs/h2E10BuilderRecord"},
            {"$ref": "#/$defs/h2AuthorityRecord"},
            {"$ref": "#/$defs/h2LockerRecord"},
            {"$ref": "#/$defs/h2RunnerRecord"},
            {"$ref": "#/$defs/h2E10TestRecord"},
            {"$ref": "#/$defs/h2LockerTestRecord"},
            {"$ref": "#/$defs/h2AuthorityTestRecord"},
            {"$ref": "#/$defs/h2PrecommitTestRecord"}
          ],
          "items": false
        },
        "p2_scope": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "prefixItems": [
            {"$ref": "#/$defs/p2EndToEndRecord"},
            {"$ref": "#/$defs/p2EnvironmentRecord"},
            {"$ref": "#/$defs/p2OpenapiRecord"},
            {"$ref": "#/$defs/p2OpenapiContractRecord"},
            {"$ref": "#/$defs/p2PublicTestsRecord"},
            {"$ref": "#/$defs/p2ManifestRecord"},
            {"$ref": "#/$defs/p2TestReportRecord"}
          ],
          "items": false
        }
      }
    },
    "attempt_1_failure_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "decoded", "path", "sha256"],
      "properties": {
        "path": {
          "const": "reports/closure_v1/00_protocol/closure_e0_u_attempt_1_failure.json"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "decoded": {"$ref": "#/$defs/attempt1FailureReceipt"}
      }
    },
    "outcome_access_log_prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "first_execution_id",
        "path",
        "record_count",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "reports/closure_v1/00_protocol/outcome_access_log.jsonl"
        },
        "bytes": {"const": 256},
        "sha256": {
          "const": "ae3e47dd6ad1f05cd79e6a494174f951f1c71fa9336514640bd4c15855c1b038"
        },
        "record_count": {"const": 1},
        "first_execution_id": {
          "const": "closure-v1-e0-u-caaf2d6d0a00a31f-735c2cf8ab3715aa"
        }
      }
    },
    "sealed_batch_contract_sha256": {"$ref": "#/$defs/sha256"},
    "expected_artifact_paths_sha256": {"$ref": "#/$defs/sha256"},
    "expected_publication_order_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_authority_source_record": {
      "$ref": "#/$defs/authoritySourceRecord"
    },
    "recovery_source_records": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/recoverySchemaSourceRecord"},
        {"$ref": "#/$defs/recoveryDocumentSourceRecord"},
        {"$ref": "#/$defs/recoveryReceiptSourceRecord"},
        {"$ref": "#/$defs/recoveryCommandSourceRecord"},
        {"$ref": "#/$defs/recoveryLockerSourceRecord"}
