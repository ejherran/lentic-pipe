      "properties": {
        "schema_version": {"const": "closure_e0_u_attempt_1_failure_v1"},
        "experiment_id": {"const": "closure_v1"},
        "gate": {"const": "E0-U"},
        "attempt_ordinal": {"const": 1},
        "execution_id": {
          "const": "closure-v1-e0-u-caaf2d6d0a00a31f-735c2cf8ab3715aa"
        },
        "historical_chain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_r_commit", "h1_commit", "p1_commit", "u1_commit"],
