      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["100644", "100755"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["A", "M"]}
      }
    },
