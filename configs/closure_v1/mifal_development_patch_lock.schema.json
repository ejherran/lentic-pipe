        "physical_inputs_sha256": {"$ref": "#/$defs/sha256"},
        "panel_projection_count": {"const": 27},
        "panel_projection": {
          "type": "array",
          "minItems": 27,
          "maxItems": 27,
          "prefixItems": [
            {"const": "source_id"},
            {"const": "site_id"},
            {"const": "year_month"},
            {"const": "mean_temperature_C"},
            {"const": "n_obs_temperature_C"},
            {"const": "qc_ok_rate_temperature_C"},
            {"const": "std_temperature_C"},
            {"const": "mean_TP_ugL"},
            {"const": "n_obs_TP_ugL"},
            {"const": "qc_ok_rate_TP_ugL"},
            {"const": "std_TP_ugL"},
            {"const": "mean_TN_ugL"},
            {"const": "n_obs_TN_ugL"},
            {"const": "qc_ok_rate_TN_ugL"},
            {"const": "std_TN_ugL"},
            {"const": "mean_secchi_depth_m"},
            {"const": "n_obs_secchi_depth_m"},
            {"const": "qc_ok_rate_secchi_depth_m"},
            {"const": "std_secchi_depth_m"},
            {"const": "mean_turbidity_NTU"},
            {"const": "n_obs_turbidity_NTU"},
            {"const": "qc_ok_rate_turbidity_NTU"},
            {"const": "std_turbidity_NTU"},
