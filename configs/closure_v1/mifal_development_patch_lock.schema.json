{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "closure-mifal-development-patch-lock-v1",
  "title": "Closure V1 E0-MR strict MIFAL development patch lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "gate",
    "patch_id",
    "experiment_id",
    "surface_id",
    "model_id",
    "status",
    "created_at_utc",
    "repository",
    "h_patch",
    "runtime_contract",
    "prelock",
    "verification",
    "authorizations",
    "seals"
  ],
  "properties": {
    "lock_version": {"const": "closure_mifal_development_patch_lock_v1"},
    "gate": {"const": "E0-MR"},
    "patch_id": {"const": "mifal_development_authority_patch_1"},
    "experiment_id": {"const": "closure_v1"},
    "surface_id": {"const": "closure_v1_wqp_adaptive_no_current_chla"},
    "model_id": {"const": "M0"},
    "status": {"const": "locked_unpublished"},
    "created_at_utc": {"type": "string"},
    "repository": {"$ref": "#/$defs/repository"},
    "h_patch": {"$ref": "#/$defs/hPatch"},
    "runtime_contract": {"$ref": "#/$defs/runtimeContract"},
    "prelock": {"$ref": "#/$defs/prelock"},
    "verification": {"$ref": "#/$defs/verification"},
    "authorizations": {"$ref": "#/$defs/authorizations"},
    "seals": {"$ref": "#/$defs/seals"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "parent",
        "branch",
        "tracking_ref",
        "tracking_head",
        "remote_head",
        "remote_observation_mode",
        "worktree_status"
      ],
      "properties": {
        "head": {"$ref": "#/$defs/gitSha"},
        "parent": {"const": "aa0d2cbfac186464a8b6e17b87d71aeedaa92c95"},
        "branch": {"const": "main"},
        "tracking_ref": {"const": "origin/main"},
        "tracking_head": {"$ref": "#/$defs/gitSha"},
        "remote_head": {"$ref": "#/$defs/gitSha"},
        "remote_observation_mode": {"const": "live_remote_main_verified"},
        "worktree_status": {"const": "clean"}
      }
    },
    "hPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "added_count",
        "modified_count",
        "deleted_count",
        "paths",
        "paths_sha256",
        "components",
        "components_sha256"
      ],
      "properties": {
        "base_commit": {"const": "aa0d2cbfac186464a8b6e17b87d71aeedaa92c95"},
        "added_count": {"const": 9},
        "modified_count": {"const": 0},
        "deleted_count": {"const": 0},
        "paths": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "paths_sha256": {"$ref": "#/$defs/sha256"},
        "components": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {"$ref": "#/$defs/fileRecord"}
        },
        "components_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "schema_subset_verified",
        "pins_verified",
        "physical_input_count",
        "physical_inputs",
        "physical_inputs_sha256",
        "panel_projection_count",
        "panel_projection",
        "evidence_groups",
        "minimum_observed_evidence_groups",
        "default_config_sha256",
        "raw_prediction_contract",
        "exact_raw_prediction_rows",
        "exact_final_path_count",
        "target_artifact_inputs",
        "target_columns_scanned"
