    "rawColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "nullable"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dtype": {"enum": ["string", "int8", "int16", "int64", "float64", "bool"]},
        "nullable": {"type": "boolean"}
      }
    },
    "rawPredictionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "canonical_sort_keys",
        "availability_status_values",
        "candidate_policy",
        "selected_family_policy",
        "success_policy",
