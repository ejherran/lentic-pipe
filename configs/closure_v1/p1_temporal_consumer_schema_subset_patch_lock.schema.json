        "records_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command", "returncode", "stdout_sha256", "stderr_sha256",
        "stdout_line_count", "stderr_line_count"
      ],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "returncode": {"const": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "stdout_line_count": {"type": "integer"},
        "stderr_line_count": {"type": "integer"}
      }
    },
    "focusedCommandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command", "returncode", "stdout_sha256", "stderr_sha256",
        "stdout_line_count", "stderr_line_count", "test_count",
        "skipped_count", "deselected_count", "summary_format",
        "duration_seconds", "duration_clock"
      ],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "returncode": {"const": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "stdout_line_count": {"type": "integer"},
        "stderr_line_count": {"type": "integer"},
        "test_count": {"type": "integer"},
        "skipped_count": {"const": 0},
        "deselected_count": {"const": 0},
        "summary_format": {"enum": ["pytest_short", "pytest_timedelta"]},
        "duration_seconds": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "duration_clock": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(?:[0-9]+ day[s]?, )?[0-9]+:[0-9]{2}:[0-9]{2}$"}
          ]
        }
      }
    },
    "dvcCommandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command", "returncode", "stdout_sha256", "stderr_sha256",
        "stdout_line_count", "stderr_line_count", "terminal_status"
